# Compare with the existing public_html/.htaccess before merging these rules.
# Keep Hostinger HTTPS, redirects, cache and other application rules as needed.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existing files and directories (assets, PDFs, DOCX, crawler files) pass through.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [END]

  # Missing static resources must return 404 rather than the SPA HTML.
  RewriteRule \.[a-zA-Z0-9]{1,10}$ - [END]

  # React Router handles extensionless routes on direct requests.
  RewriteRule ^ index.html [END]
</IfModule>
